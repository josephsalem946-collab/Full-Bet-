# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOWPayments Configuration (Côté serveur uniquement)
# NOWPAYMENTS_API_KEY: Clé API marchande sécurisée NOWPayments
NOWPAYMENTS_API_KEY="nouvo_kle_api_nowpayments_la"

# NOWPAYMENTS_IPN_SECRET: Clé secrète IPN HMAC pour validation des webhooks
NOWPAYMENTS_IPN_SECRET="nouvo_ipn_secret_la"

# NOWPAYMENTS_WALLET_ADDRESS: Adresse du wallet de retrait marchand
NOWPAYMENTS_WALLET_ADDRESS="Binance Wallet Address"

# NOWPAYMENTS_IPN_URL: URL officielle du webhook reçue par Cloud Run
NOWPAYMENTS_IPN_URL="https://ais-pre-b3qi6tme5n4s5o57ai3uy5-856675755931.us-east1.run.app/api/v1/payment/ipn-webhook"

# Binance Pay Configuration (Côté serveur uniquement)
# BINANCE_PAY_API_KEY / BINANCE_API_KEY: Clé API marchande Binance Pay
BINANCE_PAY_API_KEY="nouvo_kle_api_binance_la"
BINANCE_API_KEY="nouvo_kle_api_binance_la"

# BINANCE_PAY_SECRET_KEY / BINANCE_SECRET_KEY: Clé secrète pour signature HMAC-SHA512
BINANCE_PAY_SECRET_KEY="nouvo_secret_key_binance_la"
BINANCE_SECRET_KEY="nouvo_secret_key_binance_la"

# BINANCE_BASE_URL: URL de base officielle de l'API Binance
BINANCE_BASE_URL="https://bapi.binance.com"

# SUPPORT_EMAIL: Email officiel du support technique
SUPPORT_EMAIL="fullbet509@gmail.com"
